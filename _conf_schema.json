{
  "basic": {
    "type": "object",
    "description": "基础设置",
    "hint": "采集、缓存与低信息量过滤。",
    "items": {
      "enable_auto_capture": {
        "type": "bool",
        "default": true,
        "description": "自动采集用户消息",
        "hint": "开启后自动把用户消息写入对话缓存，供后续蒸馏。"
      },
      "capture_assistant_reply": {
        "type": "bool",
        "default": true,
        "description": "采集助手回复",
        "hint": "开启后助手回复也写入对话缓存。"
      },
      "capture_min_content_len": {
        "type": "int",
        "default": 5,
        "description": "采集最小有效字符数",
        "hint": "有效字符（去标点空白）低于此值的消息不采集。0=不启用。默认 5。"
      },
      "capture_dedup_window": {
        "type": "int",
        "default": 10,
        "description": "采集去重窗口",
        "hint": "与最近 N 条未蒸馏缓存内容重复的消息不重复写入。0=不启用。默认 10。"
      },
      "capture_skip_prefixes": {
        "type": "string",
        "default": "",
        "description": "跳过采集的内容前缀",
        "hint": "逗号分隔；以这些前缀开头的消息不采集。提醒类前缀已内置，无需手动添加。"
      },
      "capture_skip_regex": {
        "type": "string",
        "default": "",
        "description": "跳过采集的正则表达式",
        "hint": "高级过滤：匹配到的消息不写入缓存。留空不启用。"
      },
      "cache_max_rows": {
        "type": "int",
        "default": 20,
        "description": "缓存保留行数",
        "hint": "缓存超出后先压缩，保留最近 N 行。默认 20。"
      },
      "memory_max_chars": {
        "type": "int",
        "default": 220,
        "description": "记忆最大字符数",
        "hint": "规则蒸馏生成单条记忆的最大长度。默认 220。"
      }
    }
  },
  "vector_retrieval": {
    "type": "object",
    "description": "向量检索",
    "hint": "配置 Embedding 与向量召回。",
    "items": {
      "enable_vector_search": {
        "type": "bool",
        "default": false,
        "description": "启用向量检索",
        "hint": "开启后启用向量召回，提升记忆召回质量。"
      },
      "embedding_source": {
        "type": "string",
        "default": "provider",
        "invisible": true
      },
      "embedding_provider_id": {
        "type": "string",
        "default": "",
        "description": "Embedding Provider ID",
        "hint": "在记忆面板 → 向量检索 下拉选择已配置的 Embedding Provider；留空自动选第一个。",
        "obvious_hint": true
      },
      "vector_dim": {
        "type": "int",
        "default": 1024,
        "description": "向量维度",
        "hint": "所选 Embedding 模型的输出维度，需与 Provider 一致。默认 1024。"
      },
      "auto_rebuild_on_dim_change": {
        "type": "bool",
        "default": true,
        "description": "维度变更时自动重建",
        "hint": "检测到向量维度变化时自动重建向量索引。"
      },
      "standalone_embedding": {
        "type": "object",
        "invisible": true,
        "description": "",
        "items": {
          "embedding_provider": {
            "type": "string",
            "default": "volc",
            "description": ""
          },
          "embedding_api_key": {
            "type": "string",
            "default": "",
            "description": "",
            "secret": true
          },
          "embedding_model": {
            "type": "string",
            "default": "doubao-embedding-vision-251215",
            "description": ""
          },
          "embedding_base_url": {
            "type": "string",
            "default": "",
            "description": ""
          }
        }
      },
      "local_embedding": {
        "type": "object",
        "invisible": true,
        "description": "",
        "items": {
          "local_embedding_path": {
            "type": "string",
            "default": "",
            "description": ""
          },
          "local_embedding_model_file": {
            "type": "string",
            "default": "model_quantized.onnx",
            "description": ""
          },
          "local_embedding_max_length": {
            "type": "int",
            "default": 512,
            "description": ""
          }
        }
      },
      "embedding_provider": {
        "type": "string",
        "default": "volc",
        "description": "",
        "invisible": true
      },
      "embedding_api_key": {
        "type": "string",
        "default": "",
        "description": "",
        "invisible": true
      },
      "embedding_model": {
        "type": "string",
        "default": "doubao-embedding-vision-251215",
        "description": "",
        "invisible": true
      },
      "embedding_base_url": {
        "type": "string",
        "default": "",
        "description": "",
        "invisible": true
      },
      "local_embedding_path": {
        "type": "string",
        "default": "",
        "description": "",
        "invisible": true
      },
      "local_embedding_model_file": {
        "type": "string",
        "default": "model_quantized.onnx",
        "description": "",
        "invisible": true
      },
      "local_embedding_max_length": {
        "type": "int",
        "default": 512,
        "description": "",
        "invisible": true
      }
    }
  },
  "distill": {
    "type": "object",
    "description": "蒸馏调度与成本",
    "hint": "后台自动蒸馏的触发、节流与降本。",
    "items": {
      "distill_pause": {
        "type": "bool",
        "default": false,
        "description": "暂停自动蒸馏",
        "hint": "开启后停止后台自动蒸馏（不影响手动蒸馏）。"
      },
      "distill_interval_sec": {
        "type": "int",
        "default": 17280,
        "description": "蒸馏间隔（秒）",
        "hint": "后台轮询间隔，建议 14400~21600（约 4~6 次/天）。默认 17280。"
      },
      "distill_min_batch_count": {
        "type": "int",
        "default": 20,
        "description": "最小蒸馏批量",
        "hint": "单用户未蒸馏消息达到该数量才触发。建议 ≥12。默认 20。"
      },
      "distill_batch_limit": {
        "type": "int",
        "default": 80,
        "description": "单次蒸馏上限",
        "hint": "每轮最多处理的缓存消息条数。默认 80。"
      },
      "distill_user_throttle_sec": {
        "type": "int",
        "default": 0,
        "description": "单用户蒸馏冷却时间（秒）",
        "hint": "单用户两轮蒸馏的最小间隔，避免高频用户占用资源。0=不启用。"
      },
      "daily_token_budget": {
        "type": "int",
        "default": 0,
        "description": "日 token 预算上限",
        "hint": "每日蒸馏 token 上限，超出后跳过 LLM 蒸馏、仅保留规则处理。0=不限制。"
      },
      "distill_rule_gating": {
        "type": "bool",
        "default": false,
        "description": "启用规则预分级（降本）",
        "hint": "简单样本用规则处理、不调用 LLM，复杂样本才用 LLM。默认关闭。"
      },
      "distill_rule_gate_min_chars": {
        "type": "int",
        "default": 40,
        "description": "长文本升级阈值",
        "hint": "消息长度达到该值即交给 LLM，避免遗漏长文本信息。默认 40。"
      },
      "distill_prompt_cache": {
        "type": "bool",
        "default": true,
        "description": "启用蒸馏结果缓存",
        "hint": "相同对话内容复用上次蒸馏结果，命中时不再调用 LLM。默认开启。"
      },
      "distill_prompt_cache_max_rows": {
        "type": "int",
        "default": 1000,
        "description": "蒸馏缓存条目上限",
        "hint": "缓存最多保留的条目数，超出后按最近最少使用淘汰。默认 1000。"
      },
      "distill_fallback_to_rules": {
        "type": "bool",
        "default": false,
        "description": "蒸馏失败时回退规则记忆",
        "hint": "关闭时蒸馏失败直接报错、不生成记忆；开启则生成规则兜底记忆（质量较低）。默认关闭。"
      }
    }
  },
  "distill_model_settings": {
    "type": "object",
    "description": "蒸馏模型",
    "hint": "用于记忆蒸馏与手动精馏、合并等操作的 LLM 模型。",
    "items": {
      "use_independent_distill_model": {
        "type": "bool",
        "default": false,
        "description": "启用独立蒸馏模型",
        "hint": "开启后使用下方模型蒸馏，不再依赖聊天所用模型。"
      },
      "distill_provider_id": {
        "type": "string",
        "default": "",
        "description": "蒸馏 Provider",
        "hint": "后台自动蒸馏使用的模型提供商，从下拉列表选择。",
        "_special": "select_provider"
      },
      "distill_model_id": {
        "type": "string",
        "default": "",
        "description": "蒸馏 Model ID（可选）",
        "hint": "指定蒸馏模型 ID，留空使用 Provider 默认模型。"
      },
      "purify_provider_id": {
        "type": "string",
        "default": "",
        "description": "手动精馏 Provider",
        "hint": "手动精馏、合并、拆分记忆时使用的模型提供商，从下拉列表选择。",
        "_special": "select_provider"
      },
      "purify_model_id": {
        "type": "string",
        "default": "",
        "description": "手动精馏 Model ID（可选）",
        "hint": "指定手动精馏模型 ID，留空使用 Provider 默认模型。"
      }
    }
  },
  "injection": {
    "type": "object",
    "description": "记忆注入",
    "hint": "控制召回记忆如何加入对话上下文。",
    "items": {
      "enable_memory_injection": {
        "type": "bool",
        "default": true,
        "description": "启用记忆注入",
        "hint": "开启后把召回的记忆追加到对话上下文中。"
      },
      "inject_enable_vector_search": {
        "type": "bool",
        "default": false,
        "description": "注入时启用向量语义召回",
        "hint": "开启后注入前会做向量召回，需先在「向量检索」中启用向量检索。"
      },
      "inject_memory_limit": {
        "type": "int",
        "default": 5,
        "description": "注入记忆条数上限",
        "hint": "每次请求最多注入的长期记忆条数。默认 5。"
      },
      "inject_max_chars": {
        "type": "int",
        "default": 0,
        "description": "注入块最大字符数",
        "hint": "记忆块超长时截断。0=不限。建议 500~2000。"
      },
      "inject_position": {
        "type": "string",
        "default": "system_prompt",
        "description": "记忆注入位置",
        "hint": "插入位置，默认 system_prompt；extra_user_temp 不写入会话历史（需 AstrBot ≥4.28）。",
        "options": [
          "system_prompt",
          "user_message_before",
          "user_message_after",
          "slot",
          "extra_user_temp"
        ]
      },
      "inject_slot_marker": {
        "type": "string",
        "default": "{{tmemory}}",
        "description": "注入占位符",
        "hint": "注入位置选 slot 时，system_prompt 中会被替换为记忆块的占位符。"
      }
    }
  },
  "session_identity": {
    "type": "object",
    "description": "会话与身份",
    "hint": "记忆作用范围、会话隔离与重置行为。",
    "items": {
      "memory_mode": {
        "type": "string",
        "default": "hybrid",
        "description": "记忆模式",
        "hint": "hybrid（默认）蒸馏与主动工具并存；distill_only 仅蒸馏；active_only 仅主动工具。",
        "options": [
          "hybrid",
          "distill_only",
          "active_only"
        ]
      },
      "memory_scope": {
        "type": "string",
        "default": "user",
        "description": "记忆隔离范围",
        "hint": "user=所有会话共用记忆（默认）；session=按会话隔离。",
        "options": [
          "user",
          "session"
        ]
      },
      "private_memory_in_group": {
        "type": "bool",
        "default": false,
        "description": "群聊中注入私聊记忆",
        "hint": "默认关闭；开启后群聊会注入该用户私聊记忆，可能泄露隐私。"
      },
      "session_reset_policy": {
        "type": "string",
        "default": "keep",
        "description": "会话重置时的记忆处理",
        "hint": "keep=全部保留（默认）；archive=软归档会话缓存；clear=删除该会话缓存。",
        "options": [
          "keep",
          "archive",
          "clear"
        ]
      }
    }
  },
  "profile_storage": {
    "type": "object",
    "description": "用户画像",
    "hint": "用户画像的提取、存储与管理。",
    "items": {
      "profile_extraction_enabled": {
        "type": "bool",
        "default": false,
        "description": "启用画像提取",
        "hint": "开启后后台从对话缓存中提取用户画像条目。默认关闭。"
      },
      "profile_extraction_min_messages": {
        "type": "int",
        "default": 8,
        "description": "画像提取最少消息数",
        "hint": "单用户未处理消息低于此值不触发提取。建议 ≥8。默认 8。"
      },
      "profile_extraction_max_users_per_cycle": {
        "type": "int",
        "default": 10,
        "description": "每轮最多处理用户数",
        "hint": "单轮提取最多处理的用户数。默认 10。"
      },
      "profile_extraction_timeout_sec": {
        "type": "int",
        "default": 120,
        "description": "提取超时（秒）",
        "hint": "单轮画像提取的最长执行时间，超时跳过。默认 120。"
      },
      "profile_stability_default": {
        "type": "float",
        "default": 0.5,
        "description": "默认稳定性",
        "hint": "新建画像条目的初始稳定性，越高越不易被单条新证据覆盖。范围 0~1。"
      },
      "profile_auto_archive_threshold": {
        "type": "float",
        "default": 0.0,
        "description": "自动归档阈值",
        "hint": "画像条目置信度低于此值时自动归档。0=不自动归档。范围 0~1。"
      },
      "profile_max_items_per_user": {
        "type": "int",
        "default": 200,
        "description": "每用户画像条目上限",
        "hint": "超出时优先合并低质量条目。默认 200。"
      }
    }
  },
  "proactive": {
    "type": "object",
    "description": "主动性记忆",
    "hint": "周期性触发到期提醒与主动回忆，仅对同意接收的用户发送，并受限流与每日预算约束。",
    "items": {
      "proactive_enabled": {
        "type": "bool",
        "default": false,
        "description": "启用主动性记忆",
        "hint": "默认关闭；开启后按周期发送到期提醒与主动回忆。"
      },
      "proactive_interval_sec": {
        "type": "int",
        "default": 300,
        "description": "调度周期（秒）",
        "hint": "检查触发条件的间隔，最小 30。默认 300。"
      },
      "proactive_max_candidates_per_cycle": {
        "type": "int",
        "default": 5,
        "description": "单轮最多候选数",
        "hint": "每轮最多处理的主动消息条数，用于抑制批量打扰。默认 5。"
      },
      "proactive_per_user_window_sec": {
        "type": "int",
        "default": 3600,
        "description": "每用户限流窗口（秒）",
        "hint": "统计每用户发送量的时间窗口，默认 3600。"
      },
      "proactive_per_user_max_per_window": {
        "type": "int",
        "default": 3,
        "description": "窗口内每用户上限",
        "hint": "同一用户在窗口内最多收到的主动消息条数。默认 3。"
      },
      "proactive_min_interval_sec": {
        "type": "int",
        "default": 300,
        "description": "同一用户最小发送间隔（秒）",
        "hint": "同一用户两条主动消息之间的最小间隔，防止集中打扰。默认 300。"
      },
      "proactive_daily_budget": {
        "type": "int",
        "default": 20,
        "description": "每日主动消息预算",
        "hint": "全部用户每日主动消息总量上限。0=不限制。默认 20。"
      },
      "proactive_reminder_enabled": {
        "type": "bool",
        "default": true,
        "description": "启用到期提醒触发",
        "hint": "开启后到期的提醒会作为主动消息候选。"
      },
      "proactive_recall_enabled": {
        "type": "bool",
        "default": true,
        "description": "启用主动回忆触发",
        "hint": "开启后基于用户画像生成主动回忆问候。"
      },
      "proactive_opt_in_default": {
        "type": "bool",
        "default": false,
        "description": "所有用户默认接收",
        "hint": "关闭（推荐）时仅显式同意的用户接收；开启则所有用户默认接收，可退订。"
      },
      "proactive_max_message_chars": {
        "type": "int",
        "default": 200,
        "description": "主动消息最大长度",
        "hint": "主动消息文本截断长度，最小 20。默认 200。"
      }
    }
  },
  "webui_settings": {
    "type": "object",
    "description": "WebUI 管理面板",
    "hint": "独立端口的记忆管理面板，含思维导图、记忆编辑与审计日志。",
    "items": {
      "webui_enabled": {
        "type": "bool",
        "default": false,
        "description": "启用 WebUI 面板",
        "hint": "开启后在独立端口启动记忆管理面板。"
      },
      "webui_legacy_enabled": {
        "type": "bool",
        "default": false,
        "description": "启用旧版独立端口面板",
        "hint": "默认关闭；仅在需要旧版面板时开启，需同时启用 WebUI 面板。"
      },
      "webui_port": {
        "type": "int",
        "default": 9966,
        "description": "监听端口",
        "hint": "WebUI 面板监听的端口号。默认 9966。"
      },
      "webui_host": {
        "type": "string",
        "default": "0.0.0.0",
        "description": "监听地址",
        "hint": "绑定的 IP 地址。0.0.0.0 监听所有接口，127.0.0.1 仅本机。"
      },
      "webui_username": {
        "type": "string",
        "default": "admin",
        "description": "管理员用户名",
        "hint": "登录 WebUI 面板的用户名。"
      },
      "webui_password": {
        "type": "string",
        "default": "",
        "description": "管理员密码",
        "hint": "登录 WebUI 面板的密码，必须设置后面板才会启动。",
        "obvious_hint": true,
        "secret": true
      },
      "webui_ip_whitelist": {
        "type": "string",
        "default": "",
        "description": "IP 白名单",
        "hint": "允许访问的 IP，多个用逗号分隔；留空允许所有 IP。"
      },
      "webui_trust_proxy": {
        "type": "bool",
        "default": false,
        "description": "信任反向代理",
        "hint": "开启后从 X-Forwarded-For / X-Real-IP 头获取真实客户端 IP。"
      },
      "webui_token_expire_hours": {
        "type": "int",
        "default": 24,
        "description": "登录有效期（小时）",
        "hint": "登录凭证的有效时长。默认 24。"
      }
    }
  },
